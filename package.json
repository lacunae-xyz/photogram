{
  "name": "photogram",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lacunae-xyz/photogram-design-system": "0.2.0",
    "@lit-labs/router": "^0.1.4",
    "lit": "^3.3.3",
    "papaparse": "^5.3.2",
    "tslib": "^2.9.1",
    "urlpattern-polyfill": "^10.1.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && prettier --check . && stylelint '**/*.{css,ts}'",
    "format": "prettier --write .",
    "test:e2e": "cd e2e && ./docker.sh --project=screenshots --project=e2e --project=e2e-firefox --project=e2e-webkit && ./docker.sh --perf",
    "test:screenshots:update": "cd e2e && ./docker.sh --project=screenshots --project=e2e --update-snapshots",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "build:coverage": "rm -rf dist-maps && vite build --sourcemap hidden --outDir dist-maps && find dist-maps -type f ! -name '*.map' -delete",
    "test:e2e:coverage": "cd e2e && PW_COVERAGE=1 PW_COVERAGE_ARGS='--dist ../dist-maps' ./docker.sh --project=screenshots --project=e2e --project=e2e-firefox --project=e2e-webkit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/papaparse": "^5.5.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "playwright": "1.65.1",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.10.1",
    "smol-toml": "^1.9.1",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "postcss-lit": {
    "babelOptions": {
      "plugins": [
        "typescript",
        [
          "decorators",
          {
            "version": "2023-11"
          }
        ],
        "decoratorAutoAccessors"
      ]
    }
  }
}
